@page "/sync"
@inject AppStateService State
@inject NavigationManager Navigation

<!-- Header -->
<div style="margin-bottom: 1.5rem;">
    <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--accent-green); letter-spacing: 0.05em; margin-bottom: 0.2rem;">
        SAVED ON THIS DEVICE
    </div>
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-family: var(--font-serif); font-size: 2.15rem; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Offline &amp; Sync Center
            </h1>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
                See what is ready without a connection and send any work that is waiting.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <button class="btn btn-secondary" @onclick="SimulateSync" style="gap: 0.4rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Update saved course content
            </button>
            <button class="btn btn-primary" style="background-color: var(--primary-navy); gap: 0.4rem;" @onclick="SimulateSend">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Send pending work
            </button>
        </div>
    </div>
</div>

<!-- Connection Status Alert Card -->
<div class="card" style="background-color: var(--accent-green-light); border: 1px solid var(--accent-green-border); padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="width: 36px; height: 36px; border-radius: 50%; background-color: #ffffff; color: var(--accent-green); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
            ☁️
        </div>
        <div>
            <strong style="color: var(--accent-green); font-size: 0.95rem;">You're connected and up to date</strong>
            <div style="color: var(--text-secondary); font-size: 0.82rem;">Last checked today at 10:24 AM · Your recent changes have been sent.</div>
        </div>
    </div>
    <span class="badge badge-green" style="font-size: 0.82rem; padding: 0.35rem 0.75rem;">
        ✔ All systems ready
    </span>
</div>

<!-- 4 Stat Summary Cards -->
<div class="grid-4" style="margin-bottom: 2rem;">
    <div class="card" style="padding: 1.25rem;">
        <div style="font-size: 1.3rem; margin-bottom: 0.5rem;">📖</div>
        <div style="font-size: 1.85rem; font-weight: 700; font-family: var(--font-serif); line-height: 1; margin-bottom: 0.25rem;">
            3
        </div>
        <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">Courses ready offline</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">486 MB saved</div>
    </div>

    <div class="card" style="padding: 1.25rem;">
        <div style="font-size: 1.3rem; margin-bottom: 0.5rem;">📝</div>
        <div style="font-size: 1.85rem; font-weight: 700; font-family: var(--font-serif); line-height: 1; margin-bottom: 0.25rem;">
            6
        </div>
        <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">Drafts on this device</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Last saved moments ago</div>
    </div>

    <div class="card" style="padding: 1.25rem;">
        <div style="font-size: 1.3rem; margin-bottom: 0.5rem;">⬆️</div>
        <div style="font-size: 1.85rem; font-weight: 700; font-family: var(--font-serif); line-height: 1; margin-bottom: 0.25rem;">
            2
        </div>
        <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">Pending uploads</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">2 attachments · 4.2 MB</div>
    </div>

    <div class="card" style="padding: 1.25rem;">
        <div style="font-size: 1.3rem; margin-bottom: 0.5rem;">⏱️</div>
        <div style="font-size: 1.85rem; font-weight: 700; font-family: var(--font-serif); line-height: 1; margin-bottom: 0.25rem;">
            10:24
        </div>
        <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">Last updated</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Today</div>
    </div>
</div>

<!-- Main Split: Offline Courses (Left) + Pending Uploads & Storage (Right) -->
<div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Left: Courses Available List -->
    <div class="card" style="padding: 0; overflow: hidden;">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between;">
            <div>
                <h3 style="font-family: var(--font-serif); font-size: 1.2rem; margin: 0;">Courses available without a connection</h3>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Choose what to keep on this device</span>
            </div>
            <span style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">486 MB total</span>
        </div>

        <div style="display: flex; flex-direction: column;">
            <!-- Course 1 -->
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="background-color: var(--accent-green-light); color: var(--accent-green); padding: 0.4rem 0.6rem; border-radius: 6px; font-weight: 700; font-size: 0.78rem;">
                        CS-401
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 0.95rem;">Advanced Systems</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">All modules · 28 files · 3 drafts · Today, 9:42 AM</div>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 1.25rem;">
                    <span style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">214 MB</span>
                    <span class="badge badge-green">Ready offline</span>
                    <button class="btn btn-outline btn-sm" style="color: var(--text-muted); font-size: 0.8rem;">
                        🗑️ Remove from this device
                    </button>
                </div>
            </div>

            <!-- Course 2 -->
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="background-color: var(--accent-green-light); color: var(--accent-green); padding: 0.4rem 0.6rem; border-radius: 6px; font-weight: 700; font-size: 0.78rem;">
                        CS-315
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 0.95rem;">Data Structures</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Weeks 1–6 · 34 files · 1 draft · Yesterday, 4:16 PM</div>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 1.25rem;">
                    <span style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">168 MB</span>
                    <span class="badge badge-green">Ready offline</span>
                    <button class="btn btn-outline btn-sm" style="color: var(--text-muted); font-size: 0.8rem;">
                        🗑️ Remove from this device
                    </button>
                </div>
            </div>

            <!-- Course 3 -->
            <div style="padding: 1.25rem 1.5rem; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="background-color: var(--accent-blue-light); color: var(--accent-blue); padding: 0.4rem 0.6rem; border-radius: 6px; font-weight: 700; font-size: 0.78rem;">
                        ENG-210
                    </div>
                    <div>
                        <div style="font-weight: 600; font-size: 0.95rem;">Technical Writing</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Weeks 1–5 · 19 files · 2 drafts · Updating now</div>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 1.25rem;">
                    <span style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">104 MB</span>
                    <span class="badge badge-blue">Updating</span>
                    <button class="btn btn-outline btn-sm" style="color: var(--text-muted); font-size: 0.8rem;">
                        🗑️ Remove from this device
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Pending Uploads + Device Storage -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Pending Uploads -->
        <div class="card" style="padding: 1.25rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.2rem;">
                <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin: 0;">Pending uploads</h3>
                <span class="badge badge-amber">2 files</span>
            </div>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 1rem;">
                These will be sent when ready
            </span>

            <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; padding: 0.6rem; background-color: var(--bg-canvas); border-radius: var(--radius-md);">
                    <span>📄</span>
                    <div>
                        <strong>recovery-chart.png</strong>
                        <div style="font-size: 0.72rem; color: var(--text-muted);">2.8 MB · Lab Report 3</div>
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; padding: 0.6rem; background-color: var(--bg-canvas); border-radius: var(--radius-md);">
                    <span>📊</span>
                    <div>
                        <strong>results.csv</strong>
                        <div style="font-size: 0.72rem; color: var(--text-muted);">1.4 MB · Lab Report 3</div>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary" style="width: 100%; background-color: var(--primary-navy); gap: 0.4rem;" @onclick="SimulateSend">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Send pending work
            </button>
        </div>

        <!-- Device Storage Meter -->
        <div class="card" style="padding: 1.25rem;">
            <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Device storage</h3>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 0.75rem;">
                Space used by AcademIQ
            </span>

            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.5rem;">
                <span style="font-size: 1.8rem; font-weight: 700; font-family: var(--font-serif);">486 MB</span>
                <span style="font-size: 0.8rem; color: var(--text-muted);">of 2 GB available</span>
            </div>

            <div class="progress-bar-container" style="height: 8px; margin-bottom: 1rem;">
                <div class="progress-bar-fill" style="width: 24.3%;"></div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--primary-navy);"></span>
                    Courses · 392 MB
                </div>
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--accent-green);"></span>
                    Drafts &amp; files · 72 MB
                </div>
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #CBD5E1;"></span>
                    Other · 22 MB
                </div>
            </div>

            <button class="btn btn-secondary btn-sm" style="width: 100%; gap: 0.35rem;">
                ⚙️ Manage saved content
            </button>
        </div>
    </div>
</div>

<!-- Info Banner -->
<div class="card" style="padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.2rem;">ℹ️</span>
        <div>
            <strong>Your saved courses and drafts stay with you</strong>
            <div style="color: var(--text-muted); font-size: 0.8rem;">You can read, write, and attach files without a connection. AcademIQ sends changes after you reconnect.</div>
        </div>
    </div>
    <a href="#" style="color: var(--primary-navy); font-weight: 600; text-decoration: none;">Learn more &rarr;</a>
</div>

@code {
    private void SimulateSync()
    {
        // Simulation
    }

    private void SimulateSend()
    {
        // Simulation
    }
}
