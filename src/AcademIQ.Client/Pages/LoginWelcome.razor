@page "/login"
@layout LoginLayout
@inject NavigationManager Navigation
@inject AppStateService State

<div class="min-h-screen grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] bg-slate-50">
    <!-- Left Hero Column -->
    <div class="bg-gradient-to-br from-navy-950 via-navy-800 to-navy-900 text-white p-8 sm:p-14 flex flex-col justify-between relative overflow-hidden">
        <div class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>

        <div class="relative z-10">
            <!-- Brand -->
            <div class="flex items-center gap-3 mb-12">
                <div class="w-10 h-10 rounded-xl bg-white text-navy-800 flex items-center justify-center font-serif font-bold text-xl shadow-md">
                    A
                </div>
                <span class="font-serif text-2xl font-bold tracking-tight">AcademIQ</span>
            </div>

            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-xs px-3.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider mb-6 border border-white/10">
                <span>📡</span> Coursework that travels with you
            </div>

            <h1 class="font-serif text-3xl sm:text-5xl font-bold leading-tight mb-5 max-w-lg text-white">
                Keep learning, even when the connection drops.
            </h1>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-md mb-8">
                Read course materials, continue drafts, and review your schedule wherever you are. AcademIQ keeps your recent work close at hand.
            </p>

            <div class="space-y-3.5 text-xs sm:text-sm">
                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded-full bg-academic-green-500/20 text-academic-green-300 flex items-center justify-center text-xs font-bold shrink-0">✔</div>
                    <span>Course materials ready when you need them</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded-full bg-academic-green-500/20 text-academic-green-300 flex items-center justify-center text-xs font-bold shrink-0">✔</div>
                    <span>Drafts saved safely on this device</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 rounded-full bg-academic-green-500/20 text-academic-green-300 flex items-center justify-center text-xs font-bold shrink-0">✔</div>
                    <span>Updates sent when you reconnect</span>
                </div>
            </div>
        </div>

        <div class="relative z-10 text-xs text-slate-400 border-t border-white/10 pt-6 mt-12">
            Designed for focused study across campus, at home, and everywhere in between.
        </div>
    </div>

    <!-- Right Login Column -->
    <div class="flex items-center justify-center p-6 sm:p-12">
        <div class="card-base max-w-md w-full p-8 sm:p-10 shadow-lg">
            <div class="text-[11px] uppercase font-bold tracking-wider text-academic-green-600 mb-1">
                Welcome back
            </div>
            <h2 class="font-serif text-2xl font-bold text-slate-900 mb-1">
                Sign in to AcademIQ
            </h2>
            <p class="text-xs text-slate-400 mb-6">
                Use your university account to continue your coursework.
            </p>

            <div class="space-y-4 mb-5">
                <div>
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">University Email</label>
                    <input type="email" class="input-field text-xs" @bind="Email" placeholder="maya.chen@northbridge.edu" />
                </div>

                <div>
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">Password</label>
                    <input type="password" class="input-field text-xs" @bind="Password" placeholder="••••••••••••" />
                </div>
            </div>

            <div class="flex items-center justify-between text-xs text-slate-600 mb-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    <span>Remember this account</span>
                </label>
                <a href="#" class="font-semibold text-navy-800 hover:text-navy-900">Forgot password?</a>
            </div>

            <button class="btn-primary w-full py-2.5 text-sm mb-4" @onclick="HandleSignIn">
                Sign In &rarr;
            </button>

            <div class="flex items-center gap-3 my-4">
                <div class="flex-1 h-px bg-slate-200"></div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">OR</span>
                <div class="flex-1 h-px bg-slate-200"></div>
            </div>

            <button class="btn-secondary w-full py-2.5 text-sm mb-5 gap-2" @onclick="HandleContinueOffline">
                📡 Continue offline
            </button>

            <div class="bg-academic-green-50/70 border border-academic-green-200 rounded-xl p-3.5 text-xs text-academic-green-700 flex items-start gap-2.5 mb-6">
                <span class="text-sm">🛡️</span>
                <span>Returning users can continue without a connection. Your drafts and recent changes remain saved on this device.</span>
            </div>

            <div class="text-center text-xs text-slate-400">
                Need help accessing your account? <a href="#" class="font-semibold text-navy-800 hover:text-navy-900">Contact university support</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string Email { get; set; } = "maya.chen@northbridge.edu";
    private string Password { get; set; } = "password123";

    private void HandleSignIn()
    {
        State.IsOfflineMode = false;
        Navigation.NavigateTo("/");
    }

    private void HandleContinueOffline()
    {
        State.IsOfflineMode = true;
        Navigation.NavigateTo("/");
    }
}
