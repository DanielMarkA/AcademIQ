@page "/courses"
@inject AppStateService State
@inject NavigationManager Navigation

<!-- Header -->
<div class="mb-6">
    <div class="text-[11px] font-bold uppercase tracking-wider text-academic-green-600 mb-1">
        Fall 2026 · Current Term
    </div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-serif text-3xl font-bold text-slate-900 mb-1">
                My Courses
            </h1>
            <p class="text-sm text-slate-500">
                Continue where you left off and see what needs your attention next.
            </p>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:flex-initial">
                <input type="text" class="input-field pl-9 w-full sm:w-60 text-xs" placeholder="Search courses" />
                <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <button class="btn-primary shrink-0 gap-1.5" @onclick="UpdateSavedContent">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Update saved content
            </button>
        </div>
    </div>
</div>

<!-- Offline Availability Banner -->
<div class="card-base bg-academic-green-50/70 border-academic-green-200 p-4 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-white text-academic-green-600 flex items-center justify-center text-lg shadow-2xs">
            📖
        </div>
        <div>
            <strong class="text-sm font-semibold text-academic-green-700">All three courses are available on this device</strong>
            <div class="text-xs text-slate-600">Recent lessons, assignments, and your drafts are ready without a connection.</div>
        </div>
    </div>
    <div class="text-xs font-semibold text-academic-green-700 font-mono self-end sm:self-auto">
        486 MB saved
    </div>
</div>

<!-- Filter Tabs & Term Selector -->
<div class="flex items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl">
        <button class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(SelectedFilter == "all" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-500 hover:text-slate-800")" 
                @onclick='() => SelectedFilter = "all"'>
            All 3
        </button>
        <button class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(SelectedFilter == "progress" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-500 hover:text-slate-800")" 
                @onclick='() => SelectedFilter = "progress"'>
            In Progress 3
        </button>
        <button class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all @(SelectedFilter == "completed" ? "bg-white text-slate-900 shadow-2xs" : "text-slate-500 hover:text-slate-800")" 
                @onclick='() => SelectedFilter = "completed"'>
            Completed 0
        </button>
    </div>

    <div class="flex items-center gap-2 text-xs text-slate-400">
        <span>Showing Fall 2026</span>
        <button class="btn-secondary !py-1 !px-2.5 text-xs gap-1">
            Term
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </button>
    </div>
</div>

<!-- 3 Courses Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
    <!-- Course 1 -->
    <div class="card-base p-6 flex flex-col justify-between border-t-4 border-t-academic-green-500 hover:shadow-md transition-shadow">
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
                    CS-401 · Fall 2026
                </span>
                <span class="badge-status-green">Ready offline</span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-900 mb-0.5">
                Advanced Systems
            </h2>
            <div class="text-xs text-slate-500 mb-5">
                Prof. Lee
            </div>

            <div class="bg-slate-50 border border-slate-200/70 rounded-xl p-3 mb-5">
                <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400 mb-1">
                    Next Milestone
                </div>
                <div class="flex items-center justify-between text-xs font-semibold text-slate-800">
                    <span>Lab Report 3</span>
                    <span class="text-slate-400 font-normal">Due Oct 4 · 11:59 PM</span>
                </div>
            </div>

            <div class="mb-5">
                <div class="flex justify-between text-xs mb-1.5 text-slate-600">
                    <span>Course progress</span>
                    <strong class="font-semibold text-slate-900">68%</strong>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-academic-green-500 rounded-full" style="width: 68%;"></div>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 pt-4 flex items-center justify-between text-xs">
            <span class="text-slate-400">Updated today at 9:42 AM</span>
            <button class="btn-secondary !py-1 !px-3 text-xs gap-1 group" @onclick='() => NavigateToCourse("CS-401")'>
                Open course
                <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </button>
        </div>
    </div>

    <!-- Course 2 -->
    <div class="card-base p-6 flex flex-col justify-between border-t-4 border-t-academic-green-500 hover:shadow-md transition-shadow">
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
                    CS-315 · Fall 2026
                </span>
                <span class="badge-status-green">Ready offline</span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-900 mb-0.5">
                Data Structures
            </h2>
            <div class="text-xs text-slate-500 mb-5">
                Dr. Sofia Malik
            </div>

            <div class="bg-slate-50 border border-slate-200/70 rounded-xl p-3 mb-5">
                <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400 mb-1">
                    Next Milestone
                </div>
                <div class="flex items-center justify-between text-xs font-semibold text-slate-800">
                    <span>Problem Set 6</span>
                    <span class="text-slate-400 font-normal">Due Oct 7 · 9:00 AM</span>
                </div>
            </div>

            <div class="mb-5">
                <div class="flex justify-between text-xs mb-1.5 text-slate-600">
                    <span>Course progress</span>
                    <strong class="font-semibold text-slate-900">54%</strong>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-academic-green-500 rounded-full" style="width: 54%;"></div>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 pt-4 flex items-center justify-between text-xs">
            <span class="text-slate-400">Updated today at 9:42 AM</span>
            <button class="btn-secondary !py-1 !px-3 text-xs gap-1 group" @onclick='() => NavigateToCourse("CS-315")'>
                Open course
                <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </button>
        </div>
    </div>

    <!-- Course 3 -->
    <div class="card-base p-6 flex flex-col justify-between border-t-4 border-t-academic-green-500 hover:shadow-md transition-shadow">
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
                    ENG-210 · Fall 2026
                </span>
                <span class="badge-status-blue">Materials updating</span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-900 mb-0.5">
                Technical Writing
            </h2>
            <div class="text-xs text-slate-500 mb-5">
                Elena Ruiz
            </div>

            <div class="bg-slate-50 border border-slate-200/70 rounded-xl p-3 mb-5">
                <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400 mb-1">
                    Next Milestone
                </div>
                <div class="flex items-center justify-between text-xs font-semibold text-slate-800">
                    <span>Proposal revision</span>
                    <span class="text-slate-400 font-normal">Due Oct 11 · 5:00 PM</span>
                </div>
            </div>

            <div class="mb-5">
                <div class="flex justify-between text-xs mb-1.5 text-slate-600">
                    <span>Course progress</span>
                    <strong class="font-semibold text-slate-900">82%</strong>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-academic-green-500 rounded-full" style="width: 82%;"></div>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 pt-4 flex items-center justify-between text-xs">
            <span class="text-slate-400">Updated today at 9:42 AM</span>
            <button class="btn-secondary !py-1 !px-3 text-xs gap-1 group" @onclick='() => NavigateToCourse("ENG-210")'>
                Open course
                <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </button>
        </div>
    </div>
</div>

<!-- Calendar Footer Banner -->
<div class="card-base p-4 flex items-center justify-between text-xs text-slate-600">
    <div class="flex items-center gap-2">
        <span>📅</span>
        <span>Midterm break begins October 19.</span>
    </div>
    <a href="#" class="font-semibold text-navy-800 hover:text-navy-900">
        View full academic calendar &rarr;
    </a>
</div>

@code {
    private string SelectedFilter { get; set; } = "all";

    private void NavigateToCourse(string code)
    {
        Navigation.NavigateTo($"/course/{code}");
    }

    private void UpdateSavedContent() { }
}
