@page "/assignment/{AssignmentId}"
@inject AppStateService State
@inject NavigationManager Navigation

<!-- Breadcrumb -->
<div class="nav-breadcrumbs" style="margin-bottom: 1rem;">
    <a href="course/CS-401">CS-401 Advanced Systems</a>
    <span class="separator">/</span>
    <a href="courses">Assignments</a>
    <span class="separator">/</span>
    <span class="current">Lab Report 3</span>
</div>

<!-- Header -->
<div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--accent-green); letter-spacing: 0.05em; margin-bottom: 0.2rem;">
            CS-401 · ASSIGNMENT
        </div>
        <h1 style="font-family: var(--font-serif); font-size: 2.15rem; color: var(--text-primary); margin: 0 0 0.25rem 0;">
            Lab Report 3
        </h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
            Analyze system recovery behavior and communicate your findings in a concise technical report.
        </p>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="status-pill offline-ready">
            <span class="pulse-dot"></span>
            Draft saved on this device
        </span>
        <button class="btn btn-primary" style="background-color: var(--primary-navy);" @onclick="NavigateToWorkspace">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            Continue Draft
        </button>
    </div>
</div>

<!-- Meta 4-Column Grid -->
<div class="grid-4" style="margin-bottom: 2rem;">
    <div class="card" style="padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.85rem;">
        <div style="background-color: var(--bg-surface-secondary); padding: 0.6rem; border-radius: 8px; font-size: 1.1rem;">📅</div>
        <div>
            <div style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em;">DUE DATE</div>
            <div style="font-weight: 600; font-size: 0.88rem;">Oct 4 · 11:59 PM</div>
        </div>
    </div>

    <div class="card" style="padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.85rem;">
        <div style="background-color: var(--bg-surface-secondary); padding: 0.6rem; border-radius: 8px; font-size: 1.1rem;">⏱️</div>
        <div>
            <div style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em;">ESTIMATED TIME</div>
            <div style="font-weight: 600; font-size: 0.88rem;">4–6 hours</div>
        </div>
    </div>

    <div class="card" style="padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.85rem;">
        <div style="background-color: var(--bg-surface-secondary); padding: 0.6rem; border-radius: 8px; font-size: 1.1rem;">🎖️</div>
        <div>
            <div style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em;">POINTS</div>
            <div style="font-weight: 600; font-size: 0.88rem;">100 points</div>
        </div>
    </div>

    <div class="card" style="padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.85rem;">
        <div style="background-color: var(--bg-surface-secondary); padding: 0.6rem; border-radius: 8px; font-size: 1.1rem;">🚀</div>
        <div>
            <div style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em;">SUBMISSION STATUS</div>
            <div style="font-weight: 600; font-size: 0.88rem;">Draft in progress</div>
        </div>
    </div>
</div>

<!-- Main Split Layout: Brief & Requirements (Left) + Submission & Rubric Summary (Right) -->
<div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 1.5rem;">
    <!-- Left Column -->
    <div class="card" style="display: flex; flex-direction: column; gap: 2rem;">
        <!-- 01 Brief -->
        <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; margin-bottom: 0.35rem;">
                01 · ASSIGNMENT BRIEF
            </div>
            <h2 style="font-family: var(--font-serif); font-size: 1.45rem; margin-bottom: 0.75rem;">
                Observe, test, and explain recovery behavior
            </h2>
            <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1rem;">
                Design a small experiment that interrupts a running storage task, then document how the system recovers. Compare at least two recovery strategies, explain the trade-offs you observed, and support your conclusion with measured evidence.
            </p>

            <div style="background-color: var(--accent-green-light); border-left: 3px solid var(--accent-green); padding: 0.85rem 1rem; border-radius: 0 var(--radius-md) var(--radius-md) 0; font-size: 0.88rem; color: var(--accent-green);">
                💡 <strong>Focus on what your results mean:</strong> A short, well-supported explanation is stronger than a long list of observations.
            </div>
        </div>

        <div style="border-top: 1px solid var(--border-subtle); padding-top: 1.5rem;">
            <!-- 02 Learning Goals -->
            <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; margin-bottom: 1rem;">
                02 · LEARNING GOALS
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                <div style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem;">
                    <span style="background-color: var(--bg-surface-secondary); color: var(--text-secondary); font-weight: 700; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px;">01</span>
                    <span>Explain how failure and recovery affect stored information.</span>
                </div>
                <div style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem;">
                    <span style="background-color: var(--bg-surface-secondary); color: var(--text-secondary); font-weight: 700; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px;">02</span>
                    <span>Design a repeatable experiment and interpret its results.</span>
                </div>
                <div style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem;">
                    <span style="background-color: var(--bg-surface-secondary); color: var(--text-secondary); font-weight: 700; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px;">03</span>
                    <span>Communicate system behavior with clear figures and evidence.</span>
                </div>
            </div>
        </div>

        <div style="border-top: 1px solid var(--border-subtle); padding-top: 1.5rem;">
            <!-- 03 Requirements -->
            <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; margin-bottom: 1rem;">
                03 · REQUIREMENTS
            </div>
            <div class="grid-2" style="gap: 0.85rem; font-size: 0.88rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">1,200–1,600 words</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">Submit as PDF or Markdown</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">One comparison table</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">Include methods and limitations</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">At least two labeled figures</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">Use the provided sample data</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">Three or more course references</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-green);">
                    <span>✔</span> <span style="color: var(--text-secondary);">Name files with your student ID</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Submission Card + Course Materials + Rubric Summary -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Submission Card -->
        <div class="card" style="padding: 1.25rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin: 0;">Your submission</h3>
                <span class="badge badge-slate">Draft</span>
            </div>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 1rem;">
                Last saved today at 10:18 AM
            </span>

            <div style="background-color: var(--bg-canvas); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 0.88rem;">
                    <span>Lab Report 3 Draft</span>
                    <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: normal;">842 words</span>
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">
                    Saved on this device · Ready to continue
                </div>
            </div>

            <button class="btn btn-primary" style="width: 100%; margin-bottom: 0.5rem; background-color: var(--primary-navy);" @onclick="NavigateToWorkspace">
                Continue Draft
            </button>
            <button class="btn btn-secondary" style="width: 100%;" @onclick="NavigateToWorkspace">
                + Start a New Draft
            </button>
        </div>

        <!-- Course Materials -->
        <div class="card" style="padding: 1.25rem;">
            <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Course materials</h3>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 1rem;">
                Available without a connection
            </span>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.75rem; background-color: var(--bg-canvas); border-radius: var(--radius-md); font-size: 0.85rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span>📄</span>
                        <div>
                            <strong>Lab 3 guide.pdf</strong>
                            <div style="font-size: 0.72rem; color: var(--text-muted);">1.8 MB</div>
                        </div>
                    </div>
                    <span style="cursor: pointer;">⬇</span>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.75rem; background-color: var(--bg-canvas); border-radius: var(--radius-md); font-size: 0.85rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span>📊</span>
                        <div>
                            <strong>Sample recovery data.csv</strong>
                            <div style="font-size: 0.72rem; color: var(--text-muted);">420 KB</div>
                        </div>
                    </div>
                    <span style="cursor: pointer;">⬇</span>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.75rem; background-color: var(--bg-canvas); border-radius: var(--radius-md); font-size: 0.85rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span>📦</span>
                        <div>
                            <strong>Experiment starter files.zip</strong>
                            <div style="font-size: 0.72rem; color: var(--text-muted);">2.3 MB</div>
                        </div>
                    </div>
                    <span style="cursor: pointer;">⬇</span>
                </div>
            </div>
        </div>

        <!-- Rubric Summary -->
        <div class="card" style="padding: 1.25rem;">
            <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Rubric summary</h3>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 1rem;">
                How your work will be assessed
            </span>

            <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.85rem; margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between;">
                    <div>
                        <strong>Technical depth</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Clear systems reasoning, accurate analysis</div>
                    </div>
                    <strong style="color: var(--accent-green);">40%</strong>
                </div>

                <div style="display: flex; justify-content: space-between;">
                    <div>
                        <strong>Experimental method</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Repeatable steps, meaningful measurements</div>
                    </div>
                    <strong style="color: var(--accent-green);">30%</strong>
                </div>

                <div style="display: flex; justify-content: space-between;">
                    <div>
                        <strong>Communication</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Focused structure, readable figures</div>
                    </div>
                    <strong style="color: var(--accent-green);">20%</strong>
                </div>

                <div style="display: flex; justify-content: space-between;">
                    <div>
                        <strong>References</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Sources cited consistently</div>
                    </div>
                    <strong style="color: var(--accent-green);">10%</strong>
                </div>
            </div>

            <button class="btn btn-outline btn-sm" style="width: 100%;" @onclick='() => Navigation.NavigateTo("/dashboard")'>
                View full rubric &rarr;
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? AssignmentId { get; set; }

    private void NavigateToWorkspace()
    {
        Navigation.NavigateTo("/workspace");
    }
}
