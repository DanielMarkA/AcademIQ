@page "/assignment/{AssignmentId}"
@inject AppStateService State
@inject NavigationManager Navigation

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-xs text-slate-400 mb-4">
    <a href="course/CS-401" class="hover:text-slate-800 transition-colors">CS-401 Advanced Systems</a>
    <span>/</span>
    <a href="courses" class="hover:text-slate-800 transition-colors">Assignments</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">Lab Report 3</span>
</div>

<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
        <div class="text-[11px] font-bold uppercase tracking-wider text-academic-green-600 mb-1">
            CS-401 · Assignment
        </div>
        <h1 class="font-serif text-3xl font-bold text-slate-900 mb-1">
            Lab Report 3
        </h1>
        <p class="text-sm text-slate-500">
            Analyze system recovery behavior and communicate your findings in a concise technical report.
        </p>
    </div>

    <div class="flex items-center gap-3">
        <span class="badge-status-green py-1.5 px-3">
            <span class="w-2 h-2 rounded-full bg-academic-green-500 animate-pulse"></span>
            Draft saved on this device
        </span>
        <button class="btn-primary" @onclick="NavigateToWorkspace">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Continue Draft
        </button>
    </div>
</div>

<!-- 4 Meta Boxes Grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="card-base p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg">📅</div>
        <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Due Date</div>
            <div class="text-xs font-semibold text-slate-800">Oct 4 · 11:59 PM</div>
        </div>
    </div>

    <div class="card-base p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg">⏱️</div>
        <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Estimated Time</div>
            <div class="text-xs font-semibold text-slate-800">4–6 hours</div>
        </div>
    </div>

    <div class="card-base p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg">🎖️</div>
        <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Points</div>
            <div class="text-xs font-semibold text-slate-800">100 points</div>
        </div>
    </div>

    <div class="card-base p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg">🚀</div>
        <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Submission Status</div>
            <div class="text-xs font-semibold text-slate-800">Draft in progress</div>
        </div>
    </div>
</div>

<!-- Main Split: Brief & Requirements (Left) + Submission & Rubric Summary (Right) -->
<div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6">
    <!-- Left Column -->
    <div class="card-base p-6 space-y-6">
        <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                01 · Assignment Brief
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-900 mb-3">
                Observe, test, and explain recovery behavior
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Design a small experiment that interrupts a running storage task, then document how the system recovers. Compare at least two recovery strategies, explain the trade-offs you observed, and support your conclusion with measured evidence.
            </p>

            <div class="bg-academic-green-50/70 border-l-4 border-l-academic-green-500 rounded-r-xl p-3.5 text-xs text-academic-green-700">
                💡 <strong class="font-semibold">Focus on what your results mean:</strong> A short, well-supported explanation is stronger than a long list of observations.
            </div>
        </div>

        <div class="border-t border-slate-100 pt-6">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">
                02 · Learning Goals
            </div>
            <div class="space-y-3 text-xs text-slate-700">
                <div class="flex items-start gap-3">
                    <span class="bg-slate-100 text-slate-600 font-bold px-1.5 py-0.5 rounded text-[10px]">01</span>
                    <span>Explain how failure and recovery affect stored information.</span>
                </div>
                <div class="flex items-start gap-3">
                    <span class="bg-slate-100 text-slate-600 font-bold px-1.5 py-0.5 rounded text-[10px]">02</span>
                    <span>Design a repeatable experiment and interpret its results.</span>
                </div>
                <div class="flex items-start gap-3">
                    <span class="bg-slate-100 text-slate-600 font-bold px-1.5 py-0.5 rounded text-[10px]">03</span>
                    <span>Communicate system behavior with clear figures and evidence.</span>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 pt-6">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">
                03 · Requirements
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">1,200–1,600 words</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">Submit as PDF or Markdown</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">One comparison table</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">Include methods and limitations</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">At least two labeled figures</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">Use the provided sample data</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">Three or more course references</span>
                </div>
                <div class="flex items-center gap-2 text-academic-green-600">
                    <span>✔</span> <span class="text-slate-700">Name files with your student ID</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="space-y-6">
        <!-- Submission Card -->
        <div class="card-base p-5">
            <div class="flex items-center justify-between mb-1">
                <h3 class="font-serif font-semibold text-base text-slate-900">Your submission</h3>
                <span class="badge-status-slate text-[10px]">Draft</span>
            </div>
            <span class="text-[11px] text-slate-400 block mb-4">
                Last saved today at 10:18 AM
            </span>

            <div class="bg-slate-50 border border-slate-200/70 rounded-xl p-3.5 mb-4">
                <div class="flex items-center justify-between text-xs font-semibold text-slate-800">
                    <span>Lab Report 3 Draft</span>
                    <span class="text-slate-400 font-normal">842 words</span>
                </div>
                <div class="text-[11px] text-slate-400 mt-1">
                    Saved on this device · Ready to continue
                </div>
            </div>

            <button class="btn-primary w-full mb-2" @onclick="NavigateToWorkspace">
                Continue Draft
            </button>
            <button class="btn-secondary w-full text-xs" @onclick="NavigateToWorkspace">
                + Start a New Draft
            </button>
        </div>

        <!-- Course Materials -->
        <div class="card-base p-5">
            <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Course materials</h3>
            <span class="text-[11px] text-slate-400 block mb-4">
                Available without a connection
            </span>

            <div class="space-y-2 text-xs">
                <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-100 hover:bg-slate-100/70 transition-colors cursor-pointer">
                    <div class="flex items-center gap-2.5">
                        <span class="text-sm">📄</span>
                        <div>
                            <div class="font-semibold text-slate-800">Lab 3 guide.pdf</div>
                            <div class="text-[10px] text-slate-400">1.8 MB</div>
                        </div>
                    </div>
                    <span class="text-slate-400">⬇</span>
                </div>

                <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-100 hover:bg-slate-100/70 transition-colors cursor-pointer">
                    <div class="flex items-center gap-2.5">
                        <span class="text-sm">📊</span>
                        <div>
                            <div class="font-semibold text-slate-800">Sample recovery data.csv</div>
                            <div class="text-[10px] text-slate-400">420 KB</div>
                        </div>
                    </div>
                    <span class="text-slate-400">⬇</span>
                </div>

                <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-100 hover:bg-slate-100/70 transition-colors cursor-pointer">
                    <div class="flex items-center gap-2.5">
                        <span class="text-sm">📦</span>
                        <div>
                            <div class="font-semibold text-slate-800">Experiment starter files.zip</div>
                            <div class="text-[10px] text-slate-400">2.3 MB</div>
                        </div>
                    </div>
                    <span class="text-slate-400">⬇</span>
                </div>
            </div>
        </div>

        <!-- Rubric Summary -->
        <div class="card-base p-5">
            <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Rubric summary</h3>
            <span class="text-[11px] text-slate-400 block mb-4">
                How your work will be assessed
            </span>

            <div class="space-y-3 text-xs mb-4">
                <div class="flex justify-between">
                    <div>
                        <div class="font-semibold text-slate-800">Technical depth</div>
                        <div class="text-[10px] text-slate-400">Clear reasoning &amp; analysis</div>
                    </div>
                    <strong class="text-academic-green-600 font-semibold">40%</strong>
                </div>

                <div class="flex justify-between">
                    <div>
                        <div class="font-semibold text-slate-800">Experimental method</div>
                        <div class="text-[10px] text-slate-400">Repeatable steps &amp; data</div>
                    </div>
                    <strong class="text-academic-green-600 font-semibold">30%</strong>
                </div>

                <div class="flex justify-between">
                    <div>
                        <div class="font-semibold text-slate-800">Communication</div>
                        <div class="text-[10px] text-slate-400">Focused structure &amp; figures</div>
                    </div>
                    <strong class="text-academic-green-600 font-semibold">20%</strong>
                </div>

                <div class="flex justify-between">
                    <div>
                        <div class="font-semibold text-slate-800">References</div>
                        <div class="text-[10px] text-slate-400">Sources cited consistently</div>
                    </div>
                    <strong class="text-academic-green-600 font-semibold">10%</strong>
                </div>
            </div>

            <button class="btn-outline w-full text-xs" @onclick='() => Navigation.NavigateTo("/dashboard")'>
                View full rubric &rarr;
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? AssignmentId { get; set; }

    private void NavigateToWorkspace()
    {
        Navigation.NavigateTo("/workspace");
    }
}
