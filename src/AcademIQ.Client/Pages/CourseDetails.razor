@page "/course/{CourseId}"
@inject AppStateService State
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>AcademIQ · @Course.Code @Course.Title</PageTitle>

<div class="flex items-center gap-2 text-xs text-slate-400 mb-4">
    <a href="courses" class="hover:text-slate-800 transition-colors">My Courses</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">@Course.Code @Course.Title</span>
</div>

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
        <div class="text-[11px] font-bold uppercase tracking-wider text-academic-green-600 mb-1">
            @Course.Code · @Course.AcademicTerm
        </div>
        <h1 class="font-serif text-3xl font-bold text-slate-900 mb-1">
            @Course.Title
        </h1>
        <p class="text-sm text-slate-500">
            @Course.Description
        </p>
    </div>

    <div class="flex items-center gap-3">
        <button class="badge-status-green py-1.5 px-3 cursor-pointer" @onclick="ToggleOffline">
            <span class="w-2 h-2 rounded-full @(IsOffline ? "bg-academic-green-500 animate-pulse" : "bg-slate-400")"></span>
            @(IsOffline ? "Course ready offline" : "Download offline")
        </button>
        <button class="btn-secondary !py-1.5 !px-3 text-xs gap-1.5" @onclick="ShowOptionsMenu">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
            </svg>
            Course options
        </button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6 mb-6">
    <div class="card-base p-6 flex flex-col justify-between">
        <div>
            <div class="flex items-start justify-between gap-4 mb-3">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-full bg-navy-50 text-navy-800 flex items-center justify-center font-serif font-bold text-base border border-navy-200">
                        @(Course.InstructorName.StartsWith("Dr.") ? "SM" : Course.InstructorName.StartsWith("Elena") ? "ER" : "PL")
                    </div>
                    <div>
                        <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Instructor</div>
                        <h3 class="font-serif font-bold text-lg text-slate-900">@Course.InstructorName</h3>
                    </div>
                </div>
                <span class="text-xs text-slate-400">Office hours · Tue &amp; Thu, 2–4 PM</span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Explore how computer systems remain dependable under real-world constraints. Weekly modules pair concise theory with practical labs and reflective technical writing.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-6 text-xs text-slate-500 border-t border-slate-100 pt-3">
            <span>📅 Tue &amp; Thu · 10:00 AM</span>
            <span>📍 Engineering Hall 204</span>
            <span>📖 4 credits</span>
        </div>
    </div>

    <div class="card-base p-6 flex flex-col justify-between">
        <div>
            <div class="text-xs text-slate-400 mb-0.5">6 of 10 weeks underway</div>
            <h3 class="font-serif font-semibold text-base text-slate-900 mb-3">Overall progress</h3>
            
            <div class="flex items-baseline justify-between mb-2">
                <span class="text-4xl font-serif font-bold text-slate-900">
                    62<span class="text-2xl">%</span>
                </span>
                <span class="badge-status-green">On track</span>
            </div>

            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-academic-green-500 rounded-full" style="width: 62%;"></div>
            </div>
        </div>

        <div class="text-xs text-slate-400 border-t border-slate-100 pt-3">
            11 of 18 activities complete · Last activity today
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6 mb-6">
    <div class="card-base overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div>
                <h3 class="font-serif font-semibold text-base text-slate-900">Weekly modules</h3>
                <span class="text-xs text-slate-400">Lessons, activities, and course resources</span>
            </div>
            <a href="#" class="text-xs font-semibold text-navy-800 hover:text-navy-900">View all 10 weeks</a>
        </div>

        <div class="divide-y divide-slate-100">
            <div class="p-4 hover:bg-slate-50/80 transition-colors flex items-center justify-between cursor-pointer group bg-academic-blue-50/20"
                 @onclick='() => Navigation.NavigateTo("/assignment/1")'>
                <div class="flex items-center gap-4">
                    <span class="badge-status-blue font-bold text-xs py-1 px-2.5">
                        Week 5
                    </span>
                    <div>
                        <div class="font-semibold text-sm text-slate-900 group-hover:text-navy-800 transition-colors">
                            Reliable storage and recovery
                        </div>
                        <div class="text-xs text-slate-400">3 lessons · 1 lab · 2 of 4 complete</div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="badge-status-blue">In progress</span>
                    <span class="text-slate-300 group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
            </div>

            <div class="p-4 hover:bg-slate-50/80 transition-colors flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <span class="badge-status-green font-bold text-xs py-1 px-2.5">
                        Week 4
                    </span>
                    <div>
                        <div class="font-semibold text-sm text-slate-900">
                            Concurrency patterns
                        </div>
                        <div class="text-xs text-slate-400">4 lessons · 1 quiz · Completed Sep 26</div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="badge-status-green">Complete</span>
                    <span class="text-slate-300">&rarr;</span>
                </div>
            </div>

            <div class="p-4 hover:bg-slate-50/80 transition-colors flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <span class="badge-status-green font-bold text-xs py-1 px-2.5">
                        Week 3
                    </span>
                    <div>
                        <div class="font-semibold text-sm text-slate-900">
                            Processes and scheduling
                        </div>
                        <div class="text-xs text-slate-400">3 lessons · 1 discussion · Completed Sep 19</div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="badge-status-green">Complete</span>
                    <span class="text-slate-300">&rarr;</span>
                </div>
            </div>

            <div class="p-4 hover:bg-slate-50/80 transition-colors flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <span class="badge-status-green font-bold text-xs py-1 px-2.5">
                        Week 2
                    </span>
                    <div>
                        <div class="font-semibold text-sm text-slate-900">
                            System calls and boundaries
                        </div>
                        <div class="text-xs text-slate-400">4 lessons · 1 exercise · Completed Sep 12</div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="badge-status-green">Complete</span>
                    <span class="text-slate-300">&rarr;</span>
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-6">
        <div class="card-base p-5">
            <h3 class="font-serif font-semibold text-base text-slate-900 mb-3">Quick links</h3>
            <div class="space-y-2">
                <div class="p-3 bg-slate-50 hover:bg-slate-100 rounded-xl border border-slate-100 flex items-center justify-between cursor-pointer transition-colors"
                     @onclick='() => Navigation.NavigateTo("/assignment/1")'>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="text-base">📋</span>
                        <div>
                            <div class="font-semibold text-slate-800">Assignments</div>
                            <div class="text-slate-400 text-[11px]">2 open</div>
                        </div>
                    </div>
                    <span class="text-slate-400 text-xs">↗</span>
                </div>

                <div class="p-3 bg-slate-50 hover:bg-slate-100 rounded-xl border border-slate-100 flex items-center justify-between cursor-pointer transition-colors"
                     @onclick='() => Navigation.NavigateTo("/dashboard")'>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="text-base">📊</span>
                        <div>
                            <div class="font-semibold text-slate-800">Grades</div>
                            <div class="text-slate-400 text-[11px]">Current: 91%</div>
                        </div>
                    </div>
                    <span class="text-slate-400 text-xs">↗</span>
                </div>

                <div class="p-3 bg-slate-50 hover:bg-slate-100 rounded-xl border border-slate-100 flex items-center justify-between cursor-pointer transition-colors"
                     @onclick="DownloadMaterials">
                    <div class="flex items-center gap-3 text-xs">
                        <span class="text-base">📁</span>
                        <div>
                            <div class="font-semibold text-slate-800">Course materials</div>
                            <div class="text-slate-400 text-[11px]">28 files</div>
                        </div>
                    </div>
                    <span class="text-slate-400 text-xs">↗</span>
                </div>
            </div>
        </div>

        <div class="card-base p-5">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-serif font-semibold text-base text-slate-900">Upcoming work</h3>
                <span class="text-xs text-slate-400">Next 10 days</span>
            </div>

            <div class="space-y-3">
                <div class="flex items-center gap-3 text-xs cursor-pointer hover:bg-slate-50 p-1.5 rounded-lg transition-colors"
                     @onclick='() => Navigation.NavigateTo("/assignment/1")'>
                    <div class="bg-academic-amber-50 text-academic-amber-700 font-bold p-1.5 rounded-lg text-center min-w-[38px]">
                        <div class="text-sm leading-none">04</div>
                        <div class="text-[9px] uppercase">OCT</div>
                    </div>
                    <div>
                        <div class="font-semibold text-slate-800">Lab Report 3</div>
                        <div class="text-slate-400 text-[11px]">11:59 PM</div>
                    </div>
                </div>

                <div class="flex items-center gap-3 text-xs p-1.5">
                    <div class="bg-slate-100 text-slate-600 font-bold p-1.5 rounded-lg text-center min-w-[38px]">
                        <div class="text-sm leading-none">07</div>
                        <div class="text-[9px] uppercase">OCT</div>
                    </div>
                    <div>
                        <div class="font-semibold text-slate-800">Reliability quiz</div>
                        <div class="text-slate-400 text-[11px]">9:00 AM</div>
                    </div>
                </div>

                <div class="flex items-center gap-3 text-xs p-1.5">
                    <div class="bg-slate-100 text-slate-600 font-bold p-1.5 rounded-lg text-center min-w-[38px]">
                        <div class="text-sm leading-none">11</div>
                        <div class="text-[9px] uppercase">OCT</div>
                    </div>
                    <div>
                        <div class="font-semibold text-slate-800">Peer review notes</div>
                        <div class="text-slate-400 text-[11px]">5:00 PM</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-base p-5">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h3 class="font-serif font-semibold text-base text-slate-900">Recent announcements</h3>
            <span class="text-xs text-slate-400">Updates from @Course.InstructorName</span>
        </div>
        <a href="#" class="text-xs font-semibold text-navy-800 hover:text-navy-900">View all announcements &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-slate-100 pt-4 text-xs">
        <div class="flex items-start gap-3">
            <span class="badge-status-green shrink-0">New</span>
            <div>
                <strong class="font-semibold text-slate-800">Lab 3 sample data is now available</strong>
                <div class="text-slate-500 mt-0.5">Use the new dataset to verify your recovery analysis before submitting.</div>
            </div>
        </div>

        <div class="flex items-start gap-3">
            <span class="badge-status-slate shrink-0">Sep 29</span>
            <div>
                <strong class="font-semibold text-slate-800">Week 5 office hours extended</strong>
                <div class="text-slate-500 mt-0.5">Thursday office hours will run until 5:30 PM in Engineering Hall 312.</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? CourseId { get; set; }

    private Course Course => State.GetCourseByCode(CourseId ?? "CS-401") ?? State.Courses.First();
    private bool IsOffline => State.CourseOfflineStatus.TryGetValue(Course.Code, out var off) && off;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void ToggleOffline()
    {
        State.ToggleCourseOffline(Course.Code);
    }

    private void DownloadMaterials()
    {
        State.TriggerToast($"Downloaded 28 course materials for {Course.Code}");
    }

    private void ShowOptionsMenu()
    {
        State.TriggerToast($"Course options menu opened for {Course.Code}", "info");
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
