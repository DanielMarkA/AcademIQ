@page "/profile"
@inject AppStateService State
@inject NavigationManager Navigation

<!-- Top Header -->
<div style="margin-bottom: 1.5rem;">
    <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--accent-green); letter-spacing: 0.05em; margin-bottom: 0.2rem;">
        ACCOUNT SETTINGS
    </div>
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-family: var(--font-serif); font-size: 2.15rem; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Profile &amp; Settings
            </h1>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
                Manage your account, preferences, and how AcademIQ works on this device.
            </p>
        </div>

        <button class="btn btn-primary" style="background-color: var(--primary-navy); gap: 0.4rem;" @onclick="SaveSettings">
            ✔ Save changes
        </button>
    </div>
</div>

<!-- Profile Big Banner (Navy Card) -->
<div class="card" style="background-color: var(--primary-navy); color: #ffffff; padding: 1.5rem 2rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1.25rem;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background-color: #ffffff; color: var(--primary-navy); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 700; font-family: var(--font-serif);">
            @(State.CurrentUser.Role == UserRole.Instructor ? "PL" : "MC")
        </div>
        <div>
            <h2 style="color: #ffffff; font-size: 1.6rem; margin: 0 0 0.2rem 0; font-family: var(--font-serif);">
                @State.CurrentUser.FullName
            </h2>
            <div style="color: #CBD5E1; font-size: 0.88rem;">
                @(State.CurrentUser.Role == UserRole.Instructor ? "Associate Professor · Computer Science" : "B.S. Software Engineering · Student #20418")
            </div>
            <div style="color: #94A3B8; font-size: 0.78rem;">Northbridge University · School of Engineering</div>
        </div>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <button class="btn btn-secondary btn-sm" style="background-color: #ffffff; color: var(--primary-navy); border: none; gap: 0.35rem;">
            📷 Change photo
        </button>
        <button class="btn btn-outline btn-sm" style="color: #ffffff; border-color: rgba(255,255,255,0.4); gap: 0.35rem;">
            ↗ View public profile
        </button>
    </div>
</div>

<!-- Split Grid: Sidebar Navigation + Settings Cards -->
<div style="display: grid; grid-template-columns: 220px 1fr; gap: 2rem; margin-bottom: 2rem;">
    <!-- Navigation Sidebar -->
    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
        <div class="outline-item active" style="padding: 0.65rem 0.85rem; font-size: 0.9rem;">
            👤 Account
        </div>
        <div class="outline-item" style="padding: 0.65rem 0.85rem; font-size: 0.9rem;">
            🎨 Appearance
        </div>
        <div class="outline-item" style="padding: 0.65rem 0.85rem; font-size: 0.9rem;">
            🔔 Notifications
        </div>
        <div class="outline-item" style="padding: 0.65rem 0.85rem; font-size: 0.9rem;">
            ☁️ Offline preferences
        </div>
        <div class="outline-item" style="padding: 0.65rem 0.85rem; font-size: 0.9rem;">
            🛡️ Privacy
        </div>
        <div class="outline-item" style="padding: 0.65rem 0.85rem; font-size: 0.9rem;">
            ♿ Accessibility
        </div>
    </div>

    <!-- Main Settings Cards -->
    <div style="display: flex; flex-direction: column; gap: 1.75rem;">
        <!-- Account Info -->
        <div class="card">
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: 0.2rem;">Account</h3>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.5rem;">Your university profile and sign-in details</p>

            <div class="grid-2" style="margin-bottom: 1.25rem;">
                <div class="form-group">
                    <label class="form-label">DISPLAY NAME</label>
                    <input type="text" class="form-input" @bind="State.CurrentUser.FullName" />
                </div>
                <div class="form-group">
                    <label class="form-label">UNIVERSITY EMAIL</label>
                    <input type="email" class="form-input" @bind="State.CurrentUser.Email" />
                    <span style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.25rem; display: block;">Managed by your university</span>
                </div>
                <div class="form-group">
                    <label class="form-label">ROLE</label>
                    <input type="text" class="form-input" value="@State.CurrentUser.Role.ToString()" disabled />
                </div>
                <div class="form-group">
                    <label class="form-label">DEPARTMENT</label>
                    <input type="text" class="form-input" @bind="State.CurrentUser.Department" />
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
                <span style="font-size: 0.78rem; color: var(--text-muted);">Password changes are handled through your university account.</span>
                <button class="btn btn-secondary btn-sm" style="gap: 0.35rem;">
                    ↗ Manage university account
                </button>
            </div>
        </div>

        <!-- 2x2 Grid: Appearance, Notifications, Offline Preferences, Privacy -->
        <div class="grid-2">
            <!-- Appearance -->
            <div class="card">
                <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Appearance</h3>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">Choose a comfortable reading experience</p>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Color theme</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Use light, dark, or device appearance.</div>
                        </div>
                        <select class="form-select" style="width: 100px; padding: 0.25rem 0.5rem; font-size: 0.82rem; height: 32px;">
                            <option>Light</option>
                            <option>Dark</option>
                            <option>System</option>
                        </select>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Text size</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Increase text throughout AcademIQ.</div>
                        </div>
                        <select class="form-select" style="width: 100px; padding: 0.25rem 0.5rem; font-size: 0.82rem; height: 32px;">
                            <option>Default</option>
                            <option>Medium</option>
                            <option>Large</option>
                        </select>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Compact course lists</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Show more items in the same space.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Notifications -->
            <div class="card">
                <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Notifications</h3>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">Control the updates you receive</p>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Grades and feedback</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Know when grading is complete.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Deadline reminders</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Remind me 24 hours before due dates.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Course announcements</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Updates posted by instructors.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Offline Preferences -->
            <div class="card">
                <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Offline preferences</h3>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">Choose what is kept on this device</p>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Save active courses automatically</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Keep current lessons and assignments ready.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Update saved content on Wi-Fi</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Refresh course materials when Wi-Fi is available.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Storage limit</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">AcademIQ can use up to this amount.</div>
                        </div>
                        <select class="form-select" style="width: 100px; padding: 0.25rem 0.5rem; font-size: 0.82rem; height: 32px;">
                            <option>2 GB</option>
                            <option>5 GB</option>
                            <option>10 GB</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Privacy -->
            <div class="card">
                <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Privacy</h3>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">Manage information stored on this device</p>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Remember recent activity</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Show recently viewed courses and assignments.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Require sign-in after inactivity</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Ask for your password after 30 minutes.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div>
                            <strong style="font-size: 0.88rem;">Clear saved content</strong>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">Remove courses and drafts from this device only.</div>
                        </div>
                        <button class="btn btn-outline btn-sm">Review</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accessibility -->
        <div class="card">
            <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Accessibility</h3>
            <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 1.25rem;">Adjust motion, contrast, and navigation support</p>

            <div class="grid-2" style="gap: 1.25rem;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <strong style="font-size: 0.88rem;">Higher contrast</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Strengthen text and control contrast.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <strong style="font-size: 0.88rem;">Reduce motion</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Limit animated transitions and movement.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <strong style="font-size: 0.88rem;">Larger pointer targets</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Make clickable areas easier to select.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <strong style="font-size: 0.88rem;">Keyboard focus indicator</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Always show the selected control.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Sign Out Card -->
        <div class="card" style="display: flex; align-items: center; justify-content: space-between; border-color: #FECACA; background-color: #FFFDFD;">
            <div>
                <strong style="color: #991B1B;">Finished using this device?</strong>
                <div style="font-size: 0.78rem; color: var(--text-muted);">Sign out of AcademIQ. Saved course content will remain unless you remove it first.</div>
            </div>
            <button class="btn btn-danger btn-sm" @onclick='() => Navigation.NavigateTo("/login")' style="gap: 0.35rem;">
                🚪 Sign Out
            </button>
        </div>
    </div>
</div>

@code {
    private void SaveSettings()
    {
        // Saved feedback
    }
}
