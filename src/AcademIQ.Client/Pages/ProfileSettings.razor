@page "/profile"
@inject AppStateService State
@inject NavigationManager Navigation
@implements IDisposable

<div class="mb-6">
    <div class="text-[11px] font-bold uppercase tracking-wider text-academic-green-600 mb-1">
        Account Settings
    </div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-serif text-3xl font-bold text-slate-900 mb-1">
                Profile &amp; Settings
            </h1>
            <p class="text-sm text-slate-500">
                Manage your account, preferences, and how AcademIQ works on this device.
            </p>
        </div>

        <button class="btn-primary" @onclick="SaveSettings">
            ✔ Save changes
        </button>
    </div>
</div>

<div class="bg-navy-800 text-white rounded-2xl p-6 sm:p-8 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-md border border-navy-700">
    <div class="flex items-center gap-5">
        <div class="w-16 h-16 rounded-full bg-white text-navy-800 flex items-center justify-center font-serif font-bold text-2xl shadow-inner shrink-0">
            @(State.CurrentUser.Role == UserRole.Instructor ? "PL" : "MC")
        </div>
        <div>
            <h2 class="font-serif text-2xl font-bold text-white mb-1">
                @State.CurrentUser.FullName
            </h2>
            <div class="text-xs sm:text-sm text-slate-300">
                @(State.CurrentUser.Role == UserRole.Instructor ? "Associate Professor · Computer Science" : $"{State.CurrentUser.Major} · Student #{State.CurrentUser.StudentIdNumber}")
            </div>
            <div class="text-xs text-slate-400 mt-0.5">Northbridge University · School of Engineering</div>
        </div>
    </div>

    <div class="flex items-center gap-3 self-end sm:self-auto">
        <button class="btn-secondary !bg-white !text-navy-800 !border-transparent text-xs font-semibold" @onclick="ChangePhoto">
            📷 Change photo
        </button>
        <button class="btn-outline !text-white !border-white/30 hover:!bg-white/10 text-xs" @onclick="ViewProfile">
            ↗ View public profile
        </button>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8 mb-8">
    <div class="space-y-1 text-xs">
        <div class="px-3 py-2 rounded-xl @(ActiveSection == "account" ? "bg-academic-blue-50 text-academic-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-100") cursor-pointer"
             @onclick='() => ActiveSection = "account"'>
            👤 Account
        </div>
        <div class="px-3 py-2 rounded-xl @(ActiveSection == "appearance" ? "bg-academic-blue-50 text-academic-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-100") cursor-pointer"
             @onclick='() => ActiveSection = "appearance"'>
            🎨 Appearance
        </div>
        <div class="px-3 py-2 rounded-xl @(ActiveSection == "notifications" ? "bg-academic-blue-50 text-academic-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-100") cursor-pointer"
             @onclick='() => ActiveSection = "notifications"'>
            🔔 Notifications
        </div>
        <div class="px-3 py-2 rounded-xl @(ActiveSection == "offline" ? "bg-academic-blue-50 text-academic-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-100") cursor-pointer"
             @onclick='() => ActiveSection = "offline"'>
            ☁️ Offline preferences
        </div>
        <div class="px-3 py-2 rounded-xl @(ActiveSection == "privacy" ? "bg-academic-blue-50 text-academic-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-100") cursor-pointer"
             @onclick='() => ActiveSection = "privacy"'>
            🛡️ Privacy
        </div>
        <div class="px-3 py-2 rounded-xl @(ActiveSection == "accessibility" ? "bg-academic-blue-50 text-academic-blue-600 font-semibold" : "text-slate-600 hover:bg-slate-100") cursor-pointer"
             @onclick='() => ActiveSection = "accessibility"'>
            ♿ Accessibility
        </div>
    </div>

    <div class="space-y-6">
        <div class="card-base p-6">
            <h3 class="font-serif font-bold text-lg text-slate-900 mb-0.5">Account</h3>
            <p class="text-xs text-slate-400 mb-5">Your university profile and sign-in details</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">Display Name</label>
                    <input type="text" class="input-field text-xs" @bind="State.CurrentUser.FullName" />
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">University Email</label>
                    <input type="email" class="input-field text-xs" @bind="State.CurrentUser.Email" />
                    <span class="text-[10px] text-slate-400 mt-1 block">Managed by your university</span>
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">Role</label>
                    <input type="text" class="input-field text-xs bg-slate-50 text-slate-500" value="@State.CurrentUser.Role.ToString()" disabled />
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">Department</label>
                    <input type="text" class="input-field text-xs" @bind="State.CurrentUser.Department" />
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-t border-slate-100 pt-4 text-xs">
                <span class="text-slate-400">Password changes are handled through your university account.</span>
                <button class="btn-secondary !py-1.5 !px-3 text-xs" @onclick="ManageAccount">
                    ↗ Manage university account
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card-base p-5">
                <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Appearance</h3>
                <p class="text-xs text-slate-400 mb-4">Choose a comfortable reading experience</p>

                <div class="space-y-4 text-xs">
                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Color theme</strong>
                            <div class="text-slate-400 text-[11px]">Light, dark, or device.</div>
                        </div>
                        <select class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                            <option>Light</option>
                            <option>Dark</option>
                            <option>System</option>
                        </select>
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Text size</strong>
                            <div class="text-slate-400 text-[11px]">Increase text scaling.</div>
                        </div>
                        <select class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                            <option>Default</option>
                            <option>Medium</option>
                            <option>Large</option>
                        </select>
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Compact course lists</strong>
                            <div class="text-slate-400 text-[11px]">Show more items.</div>
                        </div>
                        <input type="checkbox" class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>
                </div>
            </div>

            <div class="card-base p-5">
                <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Notifications</h3>
                <p class="text-xs text-slate-400 mb-4">Control the updates you receive</p>

                <div class="space-y-4 text-xs">
                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Grades and feedback</strong>
                            <div class="text-slate-400 text-[11px]">When grading is done.</div>
                        </div>
                        <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Deadline reminders</strong>
                            <div class="text-slate-400 text-[11px]">24 hours before due dates.</div>
                        </div>
                        <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Course announcements</strong>
                            <div class="text-slate-400 text-[11px]">Instructor posts.</div>
                        </div>
                        <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>
                </div>
            </div>

            <div class="card-base p-5">
                <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Offline preferences</h3>
                <p class="text-xs text-slate-400 mb-4">Choose what is kept on this device</p>

                <div class="space-y-4 text-xs">
                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Save active courses automatically</strong>
                            <div class="text-slate-400 text-[11px]">Keep materials cached.</div>
                        </div>
                        <input type="checkbox" @bind="State.CurrentUser.OfflineModeEnabled" class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Update on Wi-Fi</strong>
                            <div class="text-slate-400 text-[11px]">Auto refresh over Wi-Fi.</div>
                        </div>
                        <input type="checkbox" @bind="State.CurrentUser.AutoSyncEnabled" class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Storage limit</strong>
                            <div class="text-slate-400 text-[11px]">Max local quota.</div>
                        </div>
                        <select class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                            <option>2 GB</option>
                            <option>5 GB</option>
                            <option>10 GB</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-base p-5">
                <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Privacy</h3>
                <p class="text-xs text-slate-400 mb-4">Manage local device history</p>

                <div class="space-y-4 text-xs">
                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Remember recent activity</strong>
                            <div class="text-slate-400 text-[11px]">Recent navigation items.</div>
                        </div>
                        <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Require sign-in</strong>
                            <div class="text-slate-400 text-[11px]">After 30 min of inactivity.</div>
                        </div>
                        <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <strong class="text-slate-800">Clear saved content</strong>
                            <div class="text-slate-400 text-[11px]">Remove local cache.</div>
                        </div>
                        <button class="btn-outline !py-1 !px-2.5 text-xs text-slate-600" @onclick="ClearCache">Clear</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-base p-5">
            <h3 class="font-serif font-semibold text-base text-slate-900 mb-0.5">Accessibility</h3>
            <p class="text-xs text-slate-400 mb-4">Adjust motion, contrast, and navigation support</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="flex items-center justify-between">
                    <div>
                        <strong class="text-slate-800">Higher contrast</strong>
                        <div class="text-slate-400 text-[11px]">Strengthen text contrast.</div>
                    </div>
                    <input type="checkbox" class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <strong class="text-slate-800">Reduce motion</strong>
                        <div class="text-slate-400 text-[11px]">Limit transitions.</div>
                    </div>
                    <input type="checkbox" class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <strong class="text-slate-800">Larger pointer targets</strong>
                        <div class="text-slate-400 text-[11px]">Easier clickable areas.</div>
                    </div>
                    <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <strong class="text-slate-800">Keyboard focus indicator</strong>
                        <div class="text-slate-400 text-[11px]">Highlight active control.</div>
                    </div>
                    <input type="checkbox" checked class="w-4 h-4 rounded text-navy-800 focus:ring-navy-800" />
                </div>
            </div>
        </div>

        <div class="card-base p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-red-200 bg-red-50/30 text-xs">
            <div>
                <strong class="text-red-900">Finished using this device?</strong>
                <div class="text-slate-500">Sign out of AcademIQ. Saved course content will remain unless removed.</div>
            </div>
            <button class="btn-secondary !border-red-200 !text-red-700 hover:!bg-red-50 text-xs shrink-0" @onclick='() => Navigation.NavigateTo("/login")'>
                🚪 Sign Out
            </button>
        </div>
    </div>
</div>

@code {
    private string ActiveSection { get; set; } = "account";

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void SaveSettings()
    {
        State.TriggerToast("Profile and preferences saved successfully!");
    }

    private void ChangePhoto()
    {
        State.TriggerToast("Photo upload dialog opened", "info");
    }

    private void ViewProfile()
    {
        State.TriggerToast($"Viewing public profile for {State.CurrentUser.FullName}", "info");
    }

    private void ManageAccount()
    {
        State.TriggerToast("Redirecting to university account portal...", "info");
    }

    private void ClearCache()
    {
        State.TriggerToast("Cleared offline temporary cache");
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
