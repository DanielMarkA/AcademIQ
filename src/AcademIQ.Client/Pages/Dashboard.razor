@page "/"
@page "/dashboard"
@inject AppStateService State
@inject NavigationManager Navigation
@implements IDisposable

<!-- Hub Header Banner -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-3 mb-1">
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900">
                Instructor Grading Hub
            </h1>
            <span class="badge-status-blue uppercase font-bold text-[11px] tracking-wide">
                CS-401 · LAB 3
            </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500">
            Evaluate submission against the published rubric · Changes are saved on your device until sync.
        </p>
    </div>

    <div class="flex items-center gap-6 text-xs bg-white px-4 py-2.5 rounded-xl border border-slate-200/80 shadow-2xs">
        <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Student</div>
            <div class="font-semibold text-slate-800">Maya Chen · #20418</div>
        </div>
        <div class="w-px h-6 bg-slate-200"></div>
        <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Submitted</div>
            <div class="font-semibold text-slate-800">Sep 28 · 14:32</div>
        </div>
    </div>
</div>

<!-- Top Assessment Grid: Rubric Matrix (Left) + Radial Score Breakdown (Right) -->
<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6 mb-6">
    @if (CurrentAssignment != null)
    {
        <RubricCalculator Assignment="CurrentAssignment" />
        <RadialScoreChart ScoreDto="@CurrentScore" 
                          CriteriaAssessedCount="@CurrentAssignment.RubricCriteria.Count"
                          OnGeneratePdfClicked="HandleGeneratePdf" />
    }
</div>

<!-- Bottom Grid: My Submission Drafts (Left) + Course Milestone Tracker (Right) -->
<div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-6">
    <!-- Submission Drafter Preview Card -->
    <div class="card-base overflow-hidden flex flex-col justify-between">
        <div>
            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h3 class="font-serif font-semibold text-base text-slate-900">My Submission Drafts</h3>
                    <span class="text-xs text-slate-400">Offline-first writing workspace</span>
                </div>
                <span class="badge-status-green text-[10px] py-0.5 px-2">
                    OFFLINE
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr_1fr] min-h-[240px]">
                <!-- Draft List Sidebar -->
                <div class="border-r border-slate-100 p-3 bg-slate-50/30 flex flex-col justify-between">
                    <div class="space-y-1">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                            Active Drafts
                        </div>
                        @foreach (var draft in State.Drafts)
                        {
                            var isActive = State.ActiveDraft?.Id == draft.Id;
                            <div class="p-2 rounded-lg cursor-pointer transition-all border @(isActive ? "bg-white border-slate-200 shadow-2xs" : "border-transparent hover:bg-slate-100/60")"
                                 @onclick="() => SelectDraft(draft)">
                                <div class="font-semibold text-xs text-slate-800 flex items-center gap-1.5 truncate">
                                    <span class="w-1.5 h-1.5 rounded-full shrink-0 @(draft.SyncStatus == SyncStatus.Synced ? "bg-academic-green-500" : "bg-academic-blue-500")"></span>
                                    <span class="truncate">@draft.AssignmentTitle</span>
                                </div>
                                <div class="text-[10px] text-slate-400 pl-3">
                                    @(draft.SyncStatus == SyncStatus.Synced ? "Submitted" : "Editing offline")
                                </div>
                            </div>
                        }
                    </div>
                    <div class="text-[10px] text-slate-400 pt-2 border-t border-slate-100">
                        2.4 MB stored locally
                    </div>
                </div>

                <!-- Raw Markdown Preview Pane -->
                <div class="bg-slate-900 text-slate-100 p-3 border-r border-slate-800 font-mono text-[11px] overflow-y-auto max-h-[240px]">
                    <div class="text-slate-500 text-[10px] uppercase mb-2 flex justify-between">
                        <span>RAW MARKDOWN</span>
                        <span>.md</span>
                    </div>
                    <pre class="whitespace-pre-wrap leading-relaxed">@(State.ActiveDraft?.MarkdownContent ?? "# Lab Report 3\n## Method\nWe implemented a service worker...")</pre>
                </div>

                <!-- HTML Preview Pane -->
                <div class="bg-white p-3 text-xs overflow-y-auto max-h-[240px]">
                    <div class="text-slate-400 text-[10px] uppercase mb-2">
                        HTML PREVIEW
                    </div>
                    <div class="prose prose-slate max-w-none text-xs leading-relaxed">
                        @((MarkupString)GetRenderedActiveDraftHtml())
                    </div>
                </div>
            </div>
        </div>

        <!-- Draft Bottom Status Bar -->
        <div class="bg-slate-50 border-t border-slate-100 px-4 py-2.5 flex items-center justify-between text-xs">
            <div class="flex items-center gap-1.5 text-academic-green-600 font-semibold">
                <span>💾</span>
                Auto-saving on your device
            </div>
            <div class="text-slate-400 text-[11px]">
                Saved 2 sec ago · Sync pending
            </div>
        </div>
    </div>

    <!-- Course Milestone Tracker Card -->
    <GanttTimeline />
</div>

@if (ShowPdfModal)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="card-base max-w-md w-full p-6 shadow-xl bg-white">
            <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">PDF Report Generated</h3>
            <p class="text-xs text-slate-600 mb-4">
                Grade report for <strong class="text-slate-900">Maya Chen (#20418)</strong> on <strong class="text-slate-900">CS-401 Lab Report 3</strong> has been compiled locally.
            </p>
            <div class="bg-slate-50 p-3.5 rounded-xl text-xs space-y-1.5 mb-5 border border-slate-100">
                <div>Score: <strong class="text-slate-900">@CurrentScore.TotalAwardedScore / @CurrentScore.MaxPossibleScore (@CurrentScore.Percentage%)</strong></div>
                <div>Grade: <strong class="text-academic-green-600">@CurrentScore.LetterGrade (GPA: @CurrentScore.GpaValue)</strong></div>
                <div>Status: <span class="badge-status-green text-[10px]">Passed</span></div>
            </div>
            <div class="flex justify-end gap-2">
                <button class="btn-secondary !py-1.5 !px-3 text-xs" @onclick="() => ShowPdfModal = false">Close</button>
                <button class="btn-primary !py-1.5 !px-3 text-xs" @onclick="() => ShowPdfModal = false">Download PDF</button>
            </div>
        </div>
    </div>
}

@code {
    private Assignment? CurrentAssignment => State.Assignments.FirstOrDefault();
    private EvaluationResultDto CurrentScore => CurrentAssignment != null ? State.GetCurrentEvaluationScore(CurrentAssignment) : new();
    private bool ShowPdfModal { get; set; } = false;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void SelectDraft(SubmissionDraft draft)
    {
        State.ActiveDraft = draft;
    }

    private string GetRenderedActiveDraftHtml()
    {
        if (string.IsNullOrEmpty(State.ActiveDraft?.MarkdownContent)) return "<p>No content</p>";
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return Markdown.ToHtml(State.ActiveDraft.MarkdownContent, pipeline);
    }

    private void HandleGeneratePdf()
    {
        ShowPdfModal = true;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
