@page "/activity"
@inject AppStateService State
@inject NavigationManager Navigation

<!-- Header -->
<div style="margin-bottom: 1.5rem;">
    <div style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; color: var(--accent-green); letter-spacing: 0.05em; margin-bottom: 0.2rem;">
        UPDATES ACROSS YOUR COURSES
    </div>
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-family: var(--font-serif); font-size: 2.15rem; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Notifications &amp; Activity
            </h1>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
                Grades, feedback, deadlines, announcements, and saved-work updates in one place.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <button class="btn btn-secondary" @onclick="State.MarkAllNotificationsAsRead" style="gap: 0.4rem;">
                ✔ Mark all as read
            </button>
            <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/profile")' style="gap: 0.4rem;">
                ⚙️ Notification settings
            </button>
        </div>
    </div>
</div>

<!-- Filter Tabs & Search -->
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; background-color: var(--bg-surface-secondary); padding: 0.25rem; border-radius: var(--radius-md);">
        <button class="btn btn-sm @(FilterCategory == "all" ? "btn-primary" : "btn-secondary")" style="border: none;" @onclick='() => FilterCategory = "all"'>
            All 8
        </button>
        <button class="btn btn-sm @(FilterCategory == "unread" ? "btn-primary" : "btn-secondary")" style="border: none;" @onclick='() => FilterCategory = "unread"'>
            Unread 2
        </button>
        <button class="btn btn-sm @(FilterCategory == "courses" ? "btn-primary" : "btn-secondary")" style="border: none;" @onclick='() => FilterCategory = "courses"'>
            Courses
        </button>
        <button class="btn btn-sm @(FilterCategory == "saved" ? "btn-primary" : "btn-secondary")" style="border: none;" @onclick='() => FilterCategory = "saved"'>
            Saved work
        </button>
    </div>

    <div style="position: relative;">
        <input type="text" class="form-input" placeholder="Search activity" style="padding-left: 2rem; width: 220px;" />
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
    </div>
</div>

<!-- Main Split: Notification Feed (Left) + Stats & Delivery Preferences (Right) -->
<div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 1.5rem;">
    <!-- Feed Column -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Group: Today -->
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; background-color: #FAFAFA;">
                <h3 style="font-family: var(--font-serif); font-size: 1.05rem; margin: 0;">Today</h3>
                <span style="font-size: 0.78rem; color: var(--text-muted);">3 updates</span>
            </div>

            <div style="display: flex; flex-direction: column;">
                <!-- Notif 1 -->
                <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--accent-green-light); color: var(--accent-green); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            ✔
                        </div>
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.45rem;">
                                <strong>Grade posted for Systems Quiz 2</strong>
                                <span style="width: 6px; height: 6px; border-radius: 50%; background-color: var(--accent-blue);"></span>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">You earned 18/20. Review the two questions you missed.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">CS-401</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">10:42 AM</div>
                    </div>
                </div>

                <!-- Notif 2 -->
                <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-surface-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            💬
                        </div>
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.45rem;">
                                <strong>Prof. Lee left feedback on your draft</strong>
                                <span style="width: 6px; height: 6px; border-radius: 50%; background-color: var(--accent-blue);"></span>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">"Your comparison is clear. Add one sentence about the limits of the sample size."</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">CS-401</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">9:18 AM</div>
                    </div>
                </div>

                <!-- Notif 3 -->
                <div style="padding: 1rem 1.25rem; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--accent-green-light); color: var(--accent-green); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            🔄
                        </div>
                        <div>
                            <strong>Your saved work is up to date</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">Lab Report 3 and two attachments were sent successfully.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">Saved work</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">8:57 AM</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Group: This Week -->
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; background-color: #FAFAFA;">
                <h3 style="font-family: var(--font-serif); font-size: 1.05rem; margin: 0;">This Week</h3>
                <span style="font-size: 0.78rem; color: var(--text-muted);">3 updates</span>
            </div>

            <div style="display: flex; flex-direction: column;">
                <!-- Notif 4 -->
                <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--accent-amber-light); color: var(--accent-amber); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            📅
                        </div>
                        <div>
                            <strong>Lab Report 3 is due Friday</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">Your draft has 842 words. Submit by Oct 4 at 11:59 PM.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-amber" style="font-size: 0.75rem;">CS-401</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Sep 30</div>
                    </div>
                </div>

                <!-- Notif 5 -->
                <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-surface-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            📢
                        </div>
                        <div>
                            <strong>New course announcement</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">Sample recovery data is now available in Course Materials.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">CS-401</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Sep 29</div>
                    </div>
                </div>

                <!-- Notif 6 -->
                <div style="padding: 1rem 1.25rem; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-surface-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            📄
                        </div>
                        <div>
                            <strong>Proposal revision received</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">Your Technical Writing assignment was received and is awaiting review.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">ENG-210</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Sep 28</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Group: Earlier -->
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; background-color: #FAFAFA;">
                <h3 style="font-family: var(--font-serif); font-size: 1.05rem; margin: 0;">Earlier</h3>
                <span style="font-size: 0.78rem; color: var(--text-muted);">2 updates</span>
            </div>

            <div style="display: flex; flex-direction: column;">
                <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-surface-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            💬
                        </div>
                        <div>
                            <strong>Discussion reply from Noah Kim</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">Noah replied to your post on amortized analysis.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">CS-315</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Sep 24</div>
                    </div>
                </div>

                <div style="padding: 1rem 1.25rem; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-surface-secondary); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            💾
                        </div>
                        <div>
                            <strong>Course materials updated</strong>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.15rem;">Week 4 readings are now saved on this device.</div>
                        </div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <span class="badge badge-green" style="font-size: 0.75rem;">CS-315</span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">Sep 23</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Status & Delivery Preferences -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Catch-up Card -->
        <div class="card" style="padding: 1.25rem;">
            <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">You're caught up</h3>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 1rem;">
                2 updates are still unread
            </span>

            <div class="grid-3" style="text-align: center; gap: 0.5rem; background-color: var(--bg-canvas); padding: 0.75rem; border-radius: var(--radius-md);">
                <div>
                    <div style="font-size: 1.4rem; font-weight: 700; font-family: var(--font-serif); color: var(--text-primary);">2</div>
                    <div style="font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted);">UNREAD</div>
                </div>
                <div>
                    <div style="font-size: 1.4rem; font-weight: 700; font-family: var(--font-serif); color: var(--text-primary);">3</div>
                    <div style="font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted);">THIS WEEK</div>
                </div>
                <div>
                    <div style="font-size: 1.4rem; font-weight: 700; font-family: var(--font-serif); color: var(--text-primary);">8</div>
                    <div style="font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted);">TOTAL</div>
                </div>
            </div>
        </div>

        <!-- Delivery Preferences Card -->
        <div class="card" style="padding: 1.25rem;">
            <h3 style="font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.2rem;">Delivery preferences</h3>
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 1rem;">
                Choose which updates reach you
            </span>

            <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem; margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Grade and feedback</span>
                    <strong style="color: var(--accent-green);">On</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span>Upcoming deadlines</span>
                    <strong style="color: var(--accent-green);">On</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span>Course announcements</span>
                    <strong style="color: var(--accent-green);">On</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span>Saved-work updates</span>
                    <strong style="color: var(--accent-green);">On</strong>
                </div>
            </div>

            <button class="btn btn-secondary btn-sm" style="width: 100%;" @onclick='() => Navigation.NavigateTo("/profile")'>
                Manage preferences
            </button>
        </div>
    </div>
</div>

@code {
    private string FilterCategory { get; set; } = "all";
}
