@inject AppStateService State

<div class="card-base p-6 flex flex-col justify-between">
    <div>
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="font-serif font-semibold text-base text-slate-900">Course Milestone Tracker</h3>
                <span class="text-xs text-slate-500">CS-401 · Fall term</span>
            </div>
            <span class="badge-status-blue font-bold text-xs px-2.5 py-0.5">
                60%
            </span>
        </div>

        <div class="w-full overflow-x-auto">
            <div class="min-w-[480px]">
                <div class="grid grid-cols-11 gap-1 items-center pb-2 border-b border-slate-100">
                    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Milestone</div>
                    @for (int w = 1; w <= 10; w++)
                    {
                        <div class="text-[11px] font-semibold text-slate-400 text-center">@w</div>
                    }
                </div>

                <div class="py-3 border-b border-slate-100 flex items-center">
                    <div class="w-1/11 pr-2">
                        <div class="font-semibold text-xs text-slate-800">Lab Report 3</div>
                        <div class="text-[10px] text-slate-400">Draft + rubric</div>
                    </div>
                    <div class="flex-1 grid grid-cols-10 gap-1 relative h-7">
                        <div class="col-start-5 col-span-2 bg-academic-green-50 text-academic-green-700 border border-academic-green-200 border-l-4 border-l-academic-green-500 rounded-md flex items-center px-2 text-[11px] font-semibold shadow-2xs truncate">
                            In-Progress
                        </div>
                    </div>
                </div>

                <div class="py-3 border-b border-slate-100 flex items-center">
                    <div class="w-1/11 pr-2">
                        <div class="font-semibold text-xs text-slate-800">Midterm</div>
                        <div class="text-[10px] text-slate-400">Oct 19 · 09:00</div>
                    </div>
                    <div class="flex-1 grid grid-cols-10 gap-1 relative h-7">
                        <div class="col-start-7 col-span-1 bg-academic-amber-50 text-academic-amber-700 border border-academic-amber-100 border-l-4 border-l-academic-amber-500 rounded-md flex items-center px-2 text-[11px] font-semibold shadow-2xs truncate">
                            Due Soon
                        </div>
                    </div>
                </div>

                <div class="py-3 flex items-center">
                    <div class="w-1/11 pr-2">
                        <div class="font-semibold text-xs text-slate-800">Final Project</div>
                        <div class="text-[10px] text-slate-400">Research build</div>
                    </div>
                    <div class="flex-1 grid grid-cols-10 gap-1 relative h-7">
                        <div class="col-start-9 col-span-2 bg-slate-100 text-slate-600 border border-slate-200 border-l-4 border-l-slate-400 rounded-md flex items-center px-2 text-[11px] font-semibold shadow-2xs truncate">
                            Upcoming
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="border-t border-slate-100 pt-4 mt-4">
        <div class="flex items-center justify-between text-xs text-slate-500">
            <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-academic-green-500"></span> Active
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-academic-amber-500"></span> Due soon
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-slate-400"></span> Upcoming
                </span>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
        </div>

        <div class="flex items-center gap-2 mt-3 text-xs text-slate-400">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>All dates stay available offline and sync when your connection returns.</span>
        </div>
    </div>
</div>
