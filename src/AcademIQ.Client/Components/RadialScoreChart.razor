@inject AppStateService State

<div class="card-base p-6 flex flex-col justify-between h-full">
    <div>
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
            <h3 class="font-serif font-semibold text-base text-slate-900">Score Breakdown</h3>
            <span class="text-xs font-medium text-slate-400">100% weighted</span>
        </div>

        <div class="relative w-40 h-40 mx-auto my-3 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 170 170">
                <circle cx="85" cy="85" r="70" stroke-width="12" fill="none" class="stroke-slate-100" />
                <circle cx="85" cy="85" r="70" stroke-width="12" fill="none" class="stroke-navy-800 transition-all duration-500 ease-out"
                        stroke-linecap="round"
                        stroke-dasharray="@Circumference"
                        stroke-dashoffset="@DashOffset" />
            </svg>

            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Final Score</span>
                <div class="text-2xl font-bold font-sans text-slate-900 leading-tight">@EarnedPoints/@MaxPoints</div>
                <span class="text-xs font-semibold text-academic-green-600">(@ScoreDto.LetterGrade)</span>
            </div>
        </div>

        <div class="flex items-center justify-between text-xs text-slate-500 my-4 px-1">
            <span>@CriteriaAssessedCount criteria assessed</span>
            <strong class="text-academic-green-600 font-semibold">@ScoreDto.Percentage%</strong>
        </div>
    </div>

    <button type="button" class="btn-primary w-full shadow-xs gap-2 py-2.5" @onclick="OnGeneratePdf">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Generate PDF Grade Report
    </button>
</div>

@code {
    [Parameter] public EvaluationResultDto ScoreDto { get; set; } = new();
    [Parameter] public int CriteriaAssessedCount { get; set; } = 3;
    [Parameter] public EventCallback OnGeneratePdfClicked { get; set; }

    private const double Radius = 70;
    private const double Circumference = 2 * Math.PI * Radius;

    private decimal EarnedPoints => ScoreDto.TotalAwardedScore;
    private decimal MaxPoints => ScoreDto.MaxPossibleScore > 0 ? ScoreDto.MaxPossibleScore : 15m;

    private double DashOffset
    {
        get
        {
            var ratio = MaxPoints > 0 ? (double)(EarnedPoints / MaxPoints) : 0;
            if (ratio > 1) ratio = 1;
            if (ratio < 0) ratio = 0;
            return Circumference * (1 - ratio);
        }
    }

    private async Task OnGeneratePdf()
    {
        if (OnGeneratePdfClicked.HasDelegate)
        {
            await OnGeneratePdfClicked.InvokeAsync();
        }
    }
}
