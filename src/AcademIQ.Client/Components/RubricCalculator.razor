@inject AppStateService State

<div class="card-base overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50/75 border-b border-slate-200">
                    <th class="py-3 px-4 text-[11px] font-bold uppercase tracking-wider text-slate-500 w-[34%]">Criteria &amp; Weight</th>
                    <th class="py-3 px-4 text-[11px] font-bold uppercase tracking-wider text-slate-500 w-[30%]">Performance Tier</th>
                    <th class="py-3 px-4 text-[11px] font-bold uppercase tracking-wider text-slate-500 w-[36%]">Evaluator Feedback</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var crit in Assignment.RubricCriteria)
                {
                    var eval = State.ActiveEvaluations.TryGetValue(crit.Id, out var e) ? e : new RubricEvaluation { RubricCriterionId = crit.Id, AwardedPoints = 0 };
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="py-4 px-4 align-top">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-semibold text-sm text-slate-900">
                                    @crit.Title
                                </span>
                                <span class="badge-status-slate text-[10px] py-0 px-1.5 font-mono">
                                    @((int)(crit.Weight * 100 / Assignment.RubricCriteria.Sum(c => c.Weight)))% weight
                                </span>
                            </div>
                            <div class="text-xs text-slate-500 mb-2 leading-relaxed">
                                @crit.Description
                            </div>
                            <div class="flex items-center gap-1.5 text-[11px] text-slate-400">
                                <span>Weight:</span>
                                <button type="button" class="w-5 h-5 rounded bg-slate-100 hover:bg-slate-200 flex items-center justify-center font-bold text-slate-700"
                                        @onclick="() => AdjustWeight(crit, -0.2m)">-</button>
                                <span class="font-mono font-semibold text-slate-700">@crit.Weight.ToString("0.0")</span>
                                <button type="button" class="w-5 h-5 rounded bg-slate-100 hover:bg-slate-200 flex items-center justify-center font-bold text-slate-700"
                                        @onclick="() => AdjustWeight(crit, 0.2m)">+</button>
                            </div>
                        </td>
                        <td class="py-4 px-4 align-top">
                            <div class="flex items-center gap-1.5 mb-1.5">
                                @for (int score = 1; score <= (int)crit.MaxPoints; score++)
                                {
                                    var currentScore = score;
                                    var isSelected = eval.AwardedPoints == currentScore;
                                    <button type="button" 
                                            class="w-8 h-8 rounded-md text-xs font-semibold flex items-center justify-center transition-all border @(isSelected ? "bg-navy-800 text-white border-navy-800 shadow-xs scale-105" : "bg-white text-slate-600 border-slate-200 hover:border-navy-800 hover:text-navy-800 hover:bg-navy-50")"
                                            @onclick="() => SelectScore(crit.Id, currentScore)"
                                            title="@GetTierDescription(currentScore)">
                                        @currentScore
                                    </button>
                                }
                            </div>
                            <div class="text-[11px] font-medium @(eval.AwardedPoints >= 4 ? "text-academic-green-600" : eval.AwardedPoints >= 3 ? "text-academic-blue-600" : "text-academic-amber-600")">
                                @GetTierTitle((int)eval.AwardedPoints) (@eval.AwardedPoints / @((int)crit.MaxPoints) pts)
                            </div>
                        </td>
                        <td class="py-4 px-4 align-top">
                            <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 focus-within:bg-white focus-within:border-navy-800 focus-within:ring-2 focus-within:ring-navy-800/10 transition-all mb-2">
                                <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                                </svg>
                                <input type="text" 
                                       class="w-full bg-transparent border-none text-xs text-slate-800 focus:outline-none placeholder-slate-400"
                                       value="@eval.FeedbackNotes" 
                                       placeholder="Add evaluator feedback..."
                                       @onchange="(evt) => UpdateNotes(crit.Id, eval.AwardedPoints, evt.Value?.ToString() ?? string.Empty)" />
                            </div>

                            <div class="flex flex-wrap gap-1">
                                <button type="button" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors"
                                        @onclick='() => AppendQuickFeedback(crit.Id, eval, "Strong depth and clear methodology.")'>
                                    + Strong depth
                                </button>
                                <button type="button" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors"
                                        @onclick='() => AppendQuickFeedback(crit.Id, eval, "Cite performance comparison tables.")'>
                                    + Cite tables
                                </button>
                                <button type="button" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors"
                                        @onclick='() => AppendQuickFeedback(crit.Id, eval, "Include edge-case test runs.")'>
                                    + Add edge cases
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public Assignment Assignment { get; set; } = new();

    private void SelectScore(Guid criterionId, int score)
    {
        var existingNotes = State.ActiveEvaluations.TryGetValue(criterionId, out var eval) ? eval.FeedbackNotes : string.Empty;
        State.SetCriterionScore(criterionId, score, existingNotes);
    }

    private void UpdateNotes(Guid criterionId, decimal currentScore, string notes)
    {
        State.SetCriterionScore(criterionId, currentScore, notes);
    }

    private void AppendQuickFeedback(Guid criterionId, RubricEvaluation eval, string snippet)
    {
        var notes = string.IsNullOrWhiteSpace(eval.FeedbackNotes) 
            ? snippet 
            : $"{eval.FeedbackNotes.TrimEnd('.')} · {snippet}";
        State.SetCriterionScore(criterionId, eval.AwardedPoints, notes);
    }

    private void AdjustWeight(RubricCriterion crit, decimal delta)
    {
        var newWeight = Math.Max(0.2m, Math.Min(3.0m, crit.Weight + delta));
        crit.Weight = Math.Round(newWeight, 1);
        State.TriggerToast($"Adjusted {crit.Title} weight to {crit.Weight:0.0}x");
    }

    private string GetTierTitle(int points) => points switch
    {
        5 => "Exemplary",
        4 => "Proficient",
        3 => "Competent",
        2 => "Developing",
        1 => "Limited",
        _ => "Not Evaluated"
    };

    private string GetTierDescription(int points) => points switch
    {
        5 => "5 pts: Exceeds standard with outstanding depth and clarity",
        4 => "4 pts: Thorough understanding with minor omissions",
        3 => "3 pts: Meets basic requirements and core criteria",
        2 => "2 pts: Demonstrates partial understanding but needs revision",
        1 => "1 pt: Incomplete or lacks supporting technical evidence",
        _ => "Unscored"
    };
}

