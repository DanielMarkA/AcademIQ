@inject AppStateService State
@inject NavigationManager Navigation
@implements IDisposable

<header class="bg-white border-b border-slate-200/80 sticky top-0 z-50 px-4 sm:px-8 py-3 flex items-center justify-between shadow-xs">
    <div class="flex items-center gap-8">
        <a href="" class="flex items-center gap-2.5 text-slate-900 group">
            <div class="w-8 h-8 rounded-lg bg-navy-800 text-white flex items-center justify-center font-serif font-bold text-lg shadow-sm group-hover:bg-navy-900 transition-colors">
                A
            </div>
            <span class="font-serif text-xl font-bold tracking-tight text-navy-900">AcademIQ</span>
        </a>

        <nav class="hidden md:flex items-center gap-6">
            <NavLink class="text-sm font-medium text-slate-600 hover:text-navy-800 transition-colors relative py-1" href="" Match="NavLinkMatch.All" ActiveClass="!text-navy-800 !font-semibold after:content-[''] after:absolute after:bottom-[-13px] after:left-0 after:right-0 after:h-0.5 after:bg-navy-800">
                Grading Hub
            </NavLink>
            <NavLink class="text-sm font-medium text-slate-600 hover:text-navy-800 transition-colors relative py-1" href="courses" ActiveClass="!text-navy-800 !font-semibold after:content-[''] after:absolute after:bottom-[-13px] after:left-0 after:right-0 after:h-0.5 after:bg-navy-800">
                My Courses
            </NavLink>
            <NavLink class="text-sm font-medium text-slate-600 hover:text-navy-800 transition-colors relative py-1 flex items-center gap-1.5" href="activity" ActiveClass="!text-navy-800 !font-semibold after:content-[''] after:absolute after:bottom-[-13px] after:left-0 after:right-0 after:h-0.5 after:bg-navy-800">
                <span>Activity</span>
                @if (UnreadCount > 0)
                {
                    <span class="px-1.5 py-0.2 bg-academic-blue-100 text-academic-blue-700 text-[10px] font-bold rounded-full">
                        @UnreadCount
                    </span>
                }
            </NavLink>
            <NavLink class="text-sm font-medium text-slate-600 hover:text-navy-800 transition-colors relative py-1 flex items-center gap-1.5" href="sync" ActiveClass="!text-navy-800 !font-semibold after:content-[''] after:absolute after:bottom-[-13px] after:left-0 after:right-0 after:h-0.5 after:bg-navy-800">
                <span>Saved &amp; Sync</span>
                @if (State.PendingUploadFiles.Count > 0)
                {
                    <span class="px-1.5 py-0.2 bg-academic-amber-100 text-academic-amber-700 text-[10px] font-bold rounded-full">
                        @State.PendingUploadFiles.Count
                    </span>
                }
            </NavLink>
            <NavLink class="text-sm font-medium text-slate-600 hover:text-navy-800 transition-colors relative py-1" href="profile" ActiveClass="!text-navy-800 !font-semibold after:content-[''] after:absolute after:bottom-[-13px] after:left-0 after:right-0 after:h-0.5 after:bg-navy-800">
                Settings
            </NavLink>
        </nav>
    </div>

    <div class="flex items-center gap-3">
        <button type="button" 
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all border @(State.IsOfflineMode ? "bg-academic-green-50 text-academic-green-600 border-academic-green-200" : "bg-academic-blue-50 text-academic-blue-600 border-academic-blue-200")"
                @onclick="State.ToggleOfflineMode"
                title="Click to toggle simulated network state">
            <span class="w-2 h-2 rounded-full @(State.IsOfflineMode ? "bg-academic-green-500 animate-pulse" : "bg-academic-blue-500")"></span>
            <span>@(State.IsOfflineMode ? "Available offline" : "Online & Synced")</span>
        </button>

        <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
            <button type="button"
                    class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-100 cursor-pointer transition-colors text-left"
                    @onclick="ToggleUserRole"
                    title="Click to toggle between Student and Instructor role">
                <div class="text-right hidden sm:block">
                    <div class="text-[10px] font-bold tracking-wider uppercase text-slate-400">@State.CurrentUser.Role.ToString().ToUpper()</div>
                    <div class="text-xs font-semibold text-slate-800">@State.CurrentUser.FullName</div>
                </div>
                <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-semibold text-xs text-slate-700">
                    @(State.CurrentUser.Role == UserRole.Instructor ? "PL" : "MC")
                </div>
            </button>
        </div>
    </div>
</header>

@code {
    private int UnreadCount => State.Notifications.Count(n => !n.IsRead);

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void ToggleUserRole()
    {
        if (State.CurrentUser.Role == UserRole.Student)
        {
            State.SwitchUser(UserRole.Instructor);
        }
        else
        {
            State.SwitchUser(UserRole.Student);
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
