@if (IsOpen)
{
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center z-50 p-4 animate-fade-in"
         @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="card-base max-w-md w-full p-6 shadow-2xl bg-white border border-slate-200 animate-scale-in">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 @(IsDanger ? "bg-red-50 text-red-600 border border-red-100" : "bg-academic-blue-50 text-academic-blue-600 border border-academic-blue-100")">
                    @(IsDanger ? "⚠️" : "ℹ️")
                </div>
                <div>
                    <h3 class="font-serif text-lg font-bold text-slate-900 leading-tight">@Title</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Please confirm your action.</p>
                </div>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed mb-6 pl-1">
                @Message
            </p>

            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100">
                <button type="button" class="btn-secondary !py-1.5 !px-3.5 text-xs" @onclick="Cancel">
                    @CancelText
                </button>
                <button type="button" class="@(IsDanger ? "inline-flex items-center justify-center px-4 py-1.5 bg-red-600 text-white rounded-lg text-xs font-semibold hover:bg-red-700 transition-colors shadow-xs" : "btn-primary !py-1.5 !px-3.5 text-xs")" 
                        @onclick="Confirm">
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Confirmation";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public bool IsDanger { get; set; } = false;
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private async Task Confirm()
    {
        IsOpen = false;
        if (OnConfirmed.HasDelegate)
        {
            await OnConfirmed.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        IsOpen = false;
        if (OnCancelled.HasDelegate)
        {
            await OnCancelled.InvokeAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Cancel();
        }
    }
}
